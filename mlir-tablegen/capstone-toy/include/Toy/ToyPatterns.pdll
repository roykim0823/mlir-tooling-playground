//===- ToyPatterns.pdll - Toy rewrite patterns in PDLL ------------------------===//
//
// The PDLL half of the capstone's rewrites (the DRR half is in ToyOps.td). Both
// end up in the same RewritePatternSet inside the -toy-fold pass; a pattern
// author picks whichever language fits — see ../../../../mlir-pdll/ for the
// lessons and the DRR-vs-PDLL comparison.
//
// CMake compiles this with `mlir-pdll -x=cpp` (add_mlir_pdll_library) into
// ToyPdllPatterns.h.inc, which ToyPatterns.cpp includes.
//
//===----------------------------------------------------------------------------===//

// The ODS definitions: gives us `{value = ...}` attribute names, `.res` result
// names, and the F64Attr constraint. (PDLL ignores the DRR `Pat` records in it.)
#include "Toy/ToyOps.td"

// Native rewrite with an inline C++ body: mlir-pdll emits it as a static
// function and registers it on the generated pattern.
Rewrite FoldMulF64(a: Attr, b: Attr) -> Attr [{
  double lhs = llvm::cast<::mlir::FloatAttr>(a).getValueAsDouble();
  double rhs = llvm::cast<::mlir::FloatAttr>(b).getValueAsDouble();
  return rewriter.getF64FloatAttr(lhs * rhs);
}];

// mul(constant a, constant b) -> constant (a * b)
Pattern FoldMulConstants {
  let root = op<toy.mul>(op<toy.constant> {value = a: F64Attr},
                         op<toy.constant> {value = b: F64Attr});
  // No result type on the new constant: an op created directly as the
  // replacement takes its result types from the root at rewrite time.
  replace root with op<toy.constant> {value = FoldMulF64(a, b)};
}

// mul(x, constant 1.0) -> x     (and the mirrored operand order)
Pattern MulByOneRight {
  let root = op<toy.mul>(x: Value, op<toy.constant> {value = attr<"1.0 : f64">});
  replace root with x;
}
Pattern MulByOneLeft {
  let root = op<toy.mul>(op<toy.constant> {value = attr<"1.0 : f64">}, x: Value);
  replace root with x;
}
