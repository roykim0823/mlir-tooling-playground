//===- 03_native_code.pdll - Lesson 3: native rewrites -------------------------===//
//
// Mirrors ../../mlir-tablegen/drr/3-native-code/03_native_code.td.
//
//   mlir-pdll -x=cpp -I $MLIR/include -I .. 03_native_code.pdll
//
//===----------------------------------------------------------------------------===//

#include "ToyOps.td"

// A NATIVE rewrite: C++ that computes something during the rewrite. Arguments
// and the return type are PDLL types (Attr, Value, Op, Type, ...); the body
// sees them as the matching MLIR C++ types and has `rewriter` in scope.
//
// DRR:  def NegateF64Attr : NativeCodeCall<"negateF64Attr($_builder, $0)">;
// (DRR only *names* a C++ function you write elsewhere; PDLL can hold the body.)
Rewrite NegateF64Attr(a: Attr) -> Attr [{
  return rewriter.getF64FloatAttr(-llvm::cast<FloatAttr>(a).getValueAsDouble());
}];

// constant-fold  neg(constant v)  ->  constant (-v)
//
// A native rewrite is called like a function inside an op<> expression. The
// new constant carries no result type: it directly replaces the root, so its
// types come from the root at rewrite time (Lesson 1). Only ops that are NOT
// the direct replacement need `-> (types)` — see Lesson 4.
//
// DRR:  def : Pat<(NegOp (ConstantOp $value)), (ConstantOp (NegateF64Attr $value))>;
Pattern NegConst {
  let root = op<toy.neg>(op<toy.constant> {value = v: Attr});
  replace root with op<toy.constant> {value = NegateF64Attr(v)};
}

// A zero-argument native rewrite.
// DRR:  def MakeZeroF64 : NativeCodeCall<"$_builder.getF64FloatAttr(0.0)">;
Rewrite MakeZeroF64() -> Attr [{ return rewriter.getF64FloatAttr(0.0); }];

// x - x  ->  constant 0.0
Pattern SubSelf {
  let root = op<toy.sub>(x: Value, x);
  replace root with op<toy.constant> {value = MakeZeroF64()};
}

// An EXTERNAL native rewrite: declared here, implemented in C++ elsewhere and
// registered at runtime with
//   patterns.getPDLPatterns().registerRewriteFunction("LogRewrite", fn);
// Use this when the C++ needs headers/state the .pdll shouldn't know about.
Rewrite LogRewrite(op: Op);

// A `rewrite ... with { ... }` BLOCK runs several statements in order. The last
// effect must dispose of the root (replace or erase).
//
// neg(neg x) -> x, logging the rewrite first.
Pattern NegNeg {
  let root = op<toy.neg>(op<toy.neg>(x: Value));
  rewrite root with {
    LogRewrite(root);
    replace root with x;
  };
}
