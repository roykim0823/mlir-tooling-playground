//===- 05_directives.pdll - Lesson 5: DRR directives, PDLL style -----------------===//
//
// Mirrors ../../drr/5-directives/05_directives.td. DRR has special
// directives (replaceWithValue, either, returnType, addBenefit); PDLL expresses
// each with ordinary language features — or, for `either`, not at all.
//
//   mlir-pdll -x=mlir -I $MLIR/include -I .. 05_directives.pdll
//
//===----------------------------------------------------------------------------===//

#include "ToyOps.td"

// replaceWithValue  ->  `replace root with <value>`
// DRR:  def : Pat<(IdentityOp $x), (replaceWithValue $x)>;
Pattern DropIdentity {
  let root = op<toy.identity>(x: Value);
  replace root with x;
}

// `either`  ->  no equivalent. PDLL matches operands positionally; write the
// two orders as two patterns (or normalise commutative operands in a
// canonicalizer first).
// DRR:  def : Pat<(AddOp (either (ConstantOp $c), $x)), (ScaleOp $x, $c)>;
Pattern AddConstLeft {
  let root = op<toy.add>(op<toy.constant> {value = c: Attr}, x: Value);
  replace root with op<toy.scale>(x) {factor = c};
}
Pattern AddConstRight {
  let root = op<toy.add>(x: Value, op<toy.constant> {value = c: Attr});
  replace root with op<toy.scale>(x) {factor = c};
}

// returnType  ->  explicit `-> (types)` on a created op. Types can be bound
// from the match (`t` below), or literals (`type<"f64">`).
// DRR:  def : Pattern<(RoundOp $x), [(CastOp:$c $x, (returnType $x)), (MulTwoOp $c)]>;
Pattern RoundViaCast {
  let root = op<toy.round>(x: Value) -> (t: Type);
  rewrite root with {
    let c = op<toy.cast>(x) -> (t);            // auxiliary op: type must be given
    replace root with op<toy.mul_two>(c.res);  // direct replacement: type inferred
  };
}

// addBenefit  ->  `with benefit(N)` on the pattern. Higher wins when several
// patterns match the same root.
// DRR:  def : Pat<(IdentityOp $x), (MulTwoOp $x), [], [], (addBenefit 10)>;
Pattern IdentityToMulTwo with benefit(10) {
  let root = op<toy.identity>(x: Value);
  replace root with op<toy.mul_two>(x);
}

// Things DRR cannot say at all:

// A WILDCARD root: `op<>` matches ANY operation. You cannot rebuild an op whose
// name you don't know, so a wildcard root is modified IN PLACE through a native
// rewrite. A rewrite block may consist solely of native rewrites, as long as
// they change the root.
//
// Here: any op with a single operand that comes from toy.identity has that
// operand redirected to the identity's input.
Rewrite ReplaceOperandWith(root: Op, old: Value, new: Value) [{
  rewriter.modifyOpInPlace(root, [&] { root->replaceUsesOfWith(old, new); });
}];

Pattern BypassIdentityOperand {
  let ident = op<toy.identity>(x: Value);
  let root = op<>(ident.res);
  rewrite root with {
    ReplaceOperandWith(root, ident.res, x);
  };
}

// A free-standing `let` with an explicit PDLL type and an initializer. Any
// variable can be declared this way and then used inside op<> expressions.
Pattern ScaleByOneIsIdentity {
  let one: Attr = attr<"1.0 : f64">;
  let root = op<toy.scale>(x: Value) {factor = one};
  replace root with x;
}
